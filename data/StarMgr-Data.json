[
    {
        "name": "getGcvsDesignation",
        "category": "Stars Manager - Star Data",
        "signature": "QString getGcvsDesignation(StarId hip)",
        "description": "Returns the GCVS (General Catalogue of Variable Stars) designation for a variable star.",
        "parameters": [
            {
                "name": "hip",
                "type": "StarId",
                "description": "Hipparcos or Gaia catalog number",
                "required": true
            }
        ],
        "returnType": "QString",
        "returnDescription": "GCVS designation (e.g., 'RR Lyr', 'δ Cep')",
        "type": "static method",
        "compatibility": {
            "qt5": true,
            "qt6": true,
            "minVersion": "0.14.0",
            "notes": "Works on all Stellarium versions"
        },
        "example": "var gcvs = StarMgr.getGcvsDesignation(95497);\ncore.debug(\"Variable star designation: \" + gcvs); // 'RR Lyr'"
    },
