            }
        ],
        "returnType": "QString",
        "returnDescription": "Component letter or empty string",
        "type": "static method",
        "compatibility": {
            "qt5": true,
            "qt6": true,
            "minVersion": "0.14.0",
            "notes": "Works on all Stellarium versions"
        },
        "example": "var component = StarMgr.convertToComponentIds(1);\ncore.debug(\"Component: \" + component); // 'A'"
    },
