    {
        "name": "convertToSpectralType",
        "category": "Stars Manager - Names",
        "signature": "QString convertToSpectralType(int index)",
        "description": "Converts a spectral type index to a human-readable spectral type string (e.g., 'G2V', 'M5III').",
        "parameters": [
            {
                "name": "index",
                "type": "int",
                "description": "Spectral type index from star catalog",
                "required": true
            }
        ],
        "returnType": "QString",
        "returnDescription": "Spectral type string",
        "type": "static method",
        "compatibility": {
            "qt5": true,
            "qt6": true,
            "minVersion": "0.10.0",
            "notes": "Works on all Stellarium versions"
        },
        "example": "var star = StarMgr.searchHP(32349);\nvar specIndex = star.getSpInt();\nvar specType = StarMgr.convertToSpectralType(specIndex);\ncore.debug(\"Spectral type: \" + specType);"
    },
    {
