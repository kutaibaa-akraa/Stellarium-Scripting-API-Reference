[
    {
        "name": "getCommonEnglishName",
        "category": "Stars Manager - Names",
        "signature": "QString getCommonEnglishName(StarId hip)",
        "description": "Returns the English common name for a star by its Hipparcos or Gaia catalog number (e.g., 'Sirius', 'Betelgeuse').",
        "parameters": [
            {
                "name": "hip",
                "type": "StarId",
                "description": "Hipparcos or Gaia catalog number",
                "required": true
            }
        ],
        "returnType": "QString",
        "returnDescription": "English common name, or empty string if none",
        "type": "static method",
        "compatibility": {
            "qt5": true,
            "qt6": true,
            "minVersion": "0.10.0",
            "notes": "Works on all Stellarium versions"
        },
        "example": "var sirius = StarMgr.searchHP(32349);\nif(sirius) {\n    var name = StarMgr.getCommonEnglishName(32349);\n    core.debug(\"Sirius common name: \" + name);\n}"
    },
