    {
        "name": "getCulturalNames",
        "category": "Stars Manager - Names",
        "signature": "QList<StelObject::CulturalName> getCulturalNames(StarId hip)",
        "description": "Returns the cultural names for a star (native names from different sky cultures).",
        "parameters": [
            {
                "name": "hip",
                "type": "StarId",
                "description": "Hipparcos or Gaia catalog number",
                "required": true
            }
        ],
        "returnType": "QList<StelObject::CulturalName>",
        "returnDescription": "List of cultural name objects",
        "type": "static method",
        "compatibility": {
            "qt5": true,
            "qt6": true,
            "minVersion": "0.15.0",
            "notes": "Works on all Stellarium versions"
        },
        "example": "var culturalNames = StarMgr.getCulturalNames(32349);\nfor(var i=0; i<culturalNames.length; i++) {\n    core.debug(\"Native: \" + culturalNames[i].native);\n    core.debug(\"Pronounce: \" + culturalNames[i].pronounce);\n}"
    },
