                "description": "Star identifier (e.g., 'HIP 32349', 'SAO 151881', 'Sirius')",
                "required": true
            }
        ],
        "returnType": "StelObjectP",
        "returnDescription": "Star object, or null if not found",
        "type": "method",
        "compatibility": {
            "qt5": true,
            "qt6": true,
            "minVersion": "0.10.0",
            "notes": "Works on all Stellarium versions"
        },
        "example": "var star = StarMgr.searchByID(\"HIP 32349\");\nstar = StarMgr.searchByID(\"SAO 151881\");\nstar = StarMgr.searchByID(\"HD 48915\");"
    },
