[
    {
        "name": "searchHP",
        "category": "Stars Manager - Search",
        "signature": "StelObjectP searchHP(int hipNumber)",
        "description": "Searches for a star by its Hipparcos catalog number.",
        "parameters": [
            {
                "name": "hipNumber",
                "type": "int",
                "description": "Hipparcos catalog number (e.g., 32349 for Sirius)",
                "required": true
            }
        ],
        "returnType": "StelObjectP",
        "returnDescription": "Star object, or null if not found",
        "type": "method",
        "compatibility": {
            "qt5": true,
            "qt6": true,
            "minVersion": "0.10.0",
            "notes": "Works on all Stellarium versions"
        },
        "example": "var sirius = StarMgr.searchHP(32349);\nif(sirius) {\n    core.debug(\"Found Sirius\");\n    core.moveToObject(sirius.getEnglishName(), 2);\n}"
    },
    {
        "name": "searchGaia",
        "category": "Stars Manager - Search",
        "signature": "StelObjectP searchGaia(StarId sourceId)",
        "description": "Searches for a star by its Gaia DR3 source ID.",
        "parameters": [
            {
                "name": "sourceId",
                "type": "StarId",
                "description": "Gaia DR3 source ID",
                "required": true
            }
        ],
        "returnType": "StelObjectP",
        "returnDescription": "Star object, or null if not found",
        "type": "method",
        "compatibility": {
            "qt5": true,
            "qt6": true,
            "minVersion": "0.19.0",
            "notes": "Requires Gaia catalog data"
        },
        "example": "var star = StarMgr.searchGaia(1679274403719601152);\nif(star) {\n    core.debug(\"Found Gaia star\");\n}"
    },
    {
        "name": "searchByID",
        "category": "Stars Manager - Search",
        "signature": "StelObjectP searchByID(QString id)",
